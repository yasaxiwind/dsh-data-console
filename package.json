{
  "name": "dsh-data-console",
  "version": "1.0.3",
  "description": "Data console for DeepSeek Harness: open CSV/Excel files, inspect column profiles, page through tables, run SQL, draw charts and export, with bounded agent tools.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "data-console",
    "csv",
    "excel",
    "sql",
    "charts",
    "pandas",
    "data-analysis"
  ],
  "license": "MIT",
  "author": "yasaxiwind",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yasaxiwind/dsh-data-console.git"
  },
  "homepage": "https://github.com/yasaxiwind/dsh-data-console#readme",
  "bugs": {
    "url": "https://github.com/yasaxiwind/dsh-data-console/issues"
  },
  "type": "module",
  "engines": {
    "dsh": ">=0.2.2-rc.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test:syntax": "node --check index.js && node --check client.js",
    "test:sidecar": "node scripts/run-sidecar-tests.mjs",
    "test:routes": "node test/routes-smoke.mjs",
    "test": "npm run test:syntax && npm run test:sidecar",
    "verify:package": "node scripts/verify-package.mjs",
    "release:check": "npm run test && npm run verify:package",
    "prepack": "npm run test:syntax && npm run verify:package",
    "market:build": "node scripts/build-market-index.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "py/sidecar.py",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "market",
    "icon.svg",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md",
    "RELEASE.md",
    "VERIFICATION.md"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  }
}
